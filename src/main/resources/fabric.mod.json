{
	"schemaVersion": 1,
	"id": "npc-avatar",
	"version": "${version}",
	"name": "NPC Avatar",
	"description": "Apply Figura avatars to any entity",
	"authors": [
		"Asinphi"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/npc-avatar/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.asinphi.npcavatar.NPCAvatar"
		],
		"client": [
			"io.asinphi.npcavatar.NPCAvatarClient"
		],
		"fabric-datagen": [
			"io.asinphi.npcavatar.NPCAvatarDataGenerator"
		]
	},
	"mixins": [
		"npc-avatar.mixins.json",
		{
			"config": "npc-avatar.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
        "figura": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}